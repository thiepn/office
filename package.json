{
  "name": "thiepn-office",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "dev": "npm run build && python3 -m http.server 8000 --bind 127.0.0.1",
    "build": "esbuild assets/structured-editor.js --bundle --minify --format=esm --target=es2022 --outfile=assets/structured-bundle.js && esbuild assets/account-runtime.ts --bundle --minify --format=esm --target=es2022 --outfile=assets/account-bundle.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/extension-table": "3.35.0"
  }
}
